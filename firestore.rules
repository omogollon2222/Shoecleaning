rules_version = '2';
// Reglas de seguridad de Shoe Cleaning (revisión 8 nov 2026).
// Copia TODO este texto en Firebase → Firestore Database → Reglas → Publicar.
// Antes de publicar, pruébalas con el emulador: ver pruebas/README.md.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn()     { return request.auth != null; }
    function profile()      { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    // Desde el 22-nov-2026 solo existen Administración y Recepción: un perfil con otro rol (Operaciones) no tiene acceso.
    function active()       { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && profile().role in ['admin', 'recepcion']; }
    function isAdmin()      { return active() && profile().role == 'admin'; }
    function isOps()        { return active() && profile().role == 'operaciones'; }
    function isRecep()      { return active() && profile().role == 'recepcion'; }
    function bootstrapped() { return exists(/databases/$(db)/documents/config/bootstrap); }
    function validRole(r)   { return r in ['admin', 'recepcion']; }
    function str(v, n)      { return v is string && v.size() <= n; }
    function money(v)       { return v is number && v >= 0 && v < 1000000; }
    function ts(v)          { return v is number && v >= 0 && v < 4102444800000; }
    function tsOrNull(v)    { return v == null || ts(v); }

    // ---------- Pedidos ----------
    function stageKeys() {
      // lavado/secado/esterilización: etapas antiguas; ya no se escriben (los pedidos viejos las conservan)
      return ['status', 'recibidoAt', 'recibidoBy', 'produccionAt', 'produccionBy', 'listoAt', 'listoBy', 'readyAt',
              'photos', 'notifiedStatus', 'notifiedAt'];
    }
    function deliveryKeys() { return ['deliveredAt', 'deliveredBy', 'paidFull', 'cobradoEntrega', 'methodFinal']; }
    function orderKeys() {
      return stageKeys().concat(deliveryKeys()).concat(['id', 'num', 'name', 'phone', 'phoneKey', 'items',
        'subtotal', 'discount', 'discountPct', 'total', 'abono', 'method', 'notes', 'createdAt', 'dueDate',
        'loyaltyRedeemed', 'createdBy', 'avisoOk', 'promoOk', 'erasedAt', 'promoName', 'promoDisc', 'manualPct', 'manualDisc']);
    }
    // Revisa el tipo de cada campo que se escribe (ks = campos nuevos o cambiados). Es liviana a propósito:
    // Firebase permite máximo 1000 operaciones por escritura. La app además limpia todo dato al leerlo (norm).
    function orderTypesOk(d, ks) {
      return (!('num' in ks)       || d.num is string)
        && (!('name' in ks)        || (d.name is string && d.name.size() <= 120))
        && (!('phone' in ks)       || d.phone is string)
        && (!('phoneKey' in ks)    || d.phoneKey is string)
        && (!('notes' in ks)       || (d.notes is string && d.notes.size() <= 2000))
        && (!('method' in ks)      || d.method in ['Efectivo', 'Transferencia'])
        && (!('methodFinal' in ks) || d.methodFinal in ['Efectivo', 'Transferencia'])
        && (!('items' in ks)       || (d.items is list && d.items.size() <= 50))
        && (!('subtotal' in ks)    || d.subtotal is number)
        && (!('discount' in ks)    || d.discount is number)
        && (!('total' in ks)       || d.total is number)
        && (!('abono' in ks)       || d.abono is number)
        && (!('cobradoEntrega' in ks) || d.cobradoEntrega is number)
        && (!('discountPct' in ks) || d.discountPct is number)
        // Descuentos: promoción + descuento manual de máximo 15 %; nunca más que el subtotal
        && (!('promoName' in ks)   || d.promoName is string)
        && (!('promoDisc' in ks)   || d.promoDisc is number)
        && (!('manualPct' in ks)   || (d.manualPct is number && d.manualPct >= 0 && d.manualPct <= 15))
        && (!('manualDisc' in ks)  || (d.manualDisc is number && d.manualDisc >= 0 && d.manualDisc <= d.subtotal * 0.15 + 0.01))
        && (!('discount' in ks)    || d.discount <= d.subtotal + 0.01)
        && (!('paidFull' in ks)    || d.paidFull is bool)
        && (!('loyaltyRedeemed' in ks) || d.loyaltyRedeemed is bool)
        && (!('avisoOk' in ks)     || d.avisoOk is bool)
        && (!('promoOk' in ks)     || d.promoOk is bool)
        && (!('dueDate' in ks)     || d.dueDate is string)
        && (!('createdAt' in ks)   || (d.createdAt is number && d.createdAt <= request.time.toMillis() + 600000))
        && (!('readyAt' in ks)     || d.readyAt == null || d.readyAt is number)
        && (!('deliveredAt' in ks) || d.deliveredAt == null || d.deliveredAt is number)
        && (!('notifiedAt' in ks)  || d.notifiedAt == null || d.notifiedAt is number)
        && (!('erasedAt' in ks)    || d.erasedAt == null || d.erasedAt is number)
        && (!('recibidoAt' in ks)  || d.recibidoAt == null || d.recibidoAt is number)
        && (!('produccionAt' in ks) || d.produccionAt == null || d.produccionAt is number)
        && (!('listoAt' in ks)     || d.listoAt == null || d.listoAt is number)
        && (!('produccionBy' in ks) || d.produccionBy is string)
        && (!('createdBy' in ks)   || d.createdBy is string)
        && (!('deliveredBy' in ks) || d.deliveredBy is string)
        && (!('recibidoBy' in ks)  || d.recibidoBy is string)
        && (!('listoBy' in ks)     || d.listoBy is string)
        && (!('notifiedStatus' in ks) || d.notifiedStatus is string)
        && (!('photos' in ks)      || (d.photos is map && d.photos.get('recepcion', 0) is int && d.photos.get('entrega', 0) is int
                                       && d.photos.get('recepcion', 0) <= 30 && d.photos.get('entrega', 0) <= 30));
    }
    // Los valores se calculan una sola vez (let) para no gastar el límite de 1000 operaciones
    function orderTypesNew() { let d = request.resource.data; let ks = d.keys().toSet(); return orderTypesOk(d, ks); }
    function orderTypesChanged() { let d = request.resource.data; let ks = d.diff(resource.data).affectedKeys(); return orderTypesOk(d, ks); }
    function statusOk(s) { return s in ['recibido', 'produccion', 'lavado', 'secado', 'esterilizacion', 'listo', 'entregado']; }

    match /orders/{id} {
      allow read: if active();

      // Crear: administrador y recepción. Siempre empieza en "recibido" y queda firmado por quien lo crea.
      allow create: if active() && !isOps()
        && request.resource.data.keys().hasOnly(orderKeys())
        && request.resource.data.keys().hasAll(['id', 'num', 'name', 'phone', 'items', 'total', 'status', 'createdAt', 'createdBy'])
        && request.resource.data.id == id
        && statusOk(request.resource.data.status)
        // Solo el administrador (al restaurar un respaldo) crea pedidos en otra etapa o a nombre de otra persona.
        && (isAdmin() || (request.resource.data.status == 'recibido' && request.resource.data.createdBy == profile().username))
        // El administrador (por ejemplo al restaurar un respaldo) no repite cada validación: así un pedido
        // completo no supera el límite de 1000 operaciones de las reglas.
        && (isAdmin() || orderTypesNew());

      // Cambiar: cada rol solo toca sus campos.
      allow update: if active()
        && request.resource.data.id == resource.data.id
        && statusOk(request.resource.data.status)
        && request.resource.data.keys().hasOnly(orderKeys().concat(resource.data.keys()))
        && orderTypesChanged()
        && (
          isAdmin()
          // Operaciones: solo avanza etapas del taller (no entrega, no cobra, no ve dinero cambiar).
          || (isOps()
              && resource.data.status != 'entregado'
              && request.resource.data.status in ['recibido', 'lavado', 'secado', 'esterilizacion', 'listo']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(stageKeys()))
          // Recepción: etapas y entrega. Un pedido ya entregado solo admite fotos y avisos;
          // deshacer una entrega o cambiar montos lo hace el administrador.
          || (isRecep()
              && resource.data.status != 'entregado'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(stageKeys().concat(deliveryKeys()))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paidFull']) || request.resource.data.paidFull == true))
          || (isRecep()
              && resource.data.status == 'entregado'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos', 'notifiedStatus', 'notifiedAt']))
        );

      allow delete: if isAdmin();
    }

    // ---------- Fotos (comprimidas en el celular, ~60 KB) ----------
    match /photos/{id} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['id', 'orderId', 'num', 'stage', 'data', 'at', 'by', 'slot', 'label'])
        && request.resource.data.id == id
        && str(request.resource.data.orderId, 40)
        && exists(/databases/$(db)/documents/orders/$(request.resource.data.orderId))
        && request.resource.data.stage in ['recepcion', 'entrega']
        && request.resource.data.data is string && request.resource.data.data.size() < 160000
        && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
        && (!('num' in request.resource.data) || str(request.resource.data.num, 30))
        && (!('at' in request.resource.data) || ts(request.resource.data.at))
        && (!('by' in request.resource.data) || str(request.resource.data.by, 60))
        && (!('slot' in request.resource.data) || (str(request.resource.data.slot, 50) && request.resource.data.slot.matches('^([A-Za-z0-9_]+:[0-9]+)?$')))
        && (!('label' in request.resource.data) || str(request.resource.data.label, 100));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- Miniaturas de las fotos (~5 KB): las listas cargan solo estas ----------
    match /thumbs/{id} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['id', 'orderId', 'stage', 'slot', 'label', 'data', 'at'])
        && request.resource.data.id == id
        && existsAfter(/databases/$(db)/documents/photos/$(id))
        && getAfter(/databases/$(db)/documents/photos/$(id)).data.orderId == request.resource.data.orderId
        && request.resource.data.stage in ['recepcion', 'entrega']
        && request.resource.data.data is string && request.resource.data.data.size() < 20000
        && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
        && str(request.resource.data.slot, 50) && request.resource.data.slot.matches('^([A-Za-z0-9_]+:[0-9]+)?$')
        && str(request.resource.data.label, 100) && ts(request.resource.data.at);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- Gastos (insumos, obligaciones, almuerzos...) ----------
    // Administrador: todo. Recepción: registra gastos del momento y ve los de las últimas 48 horas
    // (para el cierre de caja). Operaciones: no ve gastos.
    function expenseOk(d) {
      return d.keys().hasOnly(['id', 'day', 'at', 'cat', 'desc', 'provider', 'amount', 'method', 'by', 'lines'])
        && d.keys().hasAll(['id', 'day', 'at', 'cat', 'desc', 'amount', 'method', 'by'])
        && d.cat in ['insumos', 'obligaciones', 'almuerzos', 'transporte', 'mantenimiento', 'otros']
        && str(d.desc, 200) && d.desc.size() > 0
        && (!('provider' in d) || str(d.provider, 100))
        && d.amount is number && d.amount > 0 && d.amount < 100000
        && d.method in ['Efectivo', 'Transferencia']
        && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && ts(d.at) && str(d.by, 60)
        && (!('lines' in d) || (d.lines is list && d.lines.size() <= 10));
    }
    match /expenses/{id} {
      allow read: if isAdmin() || (isRecep() && resource.data.at > request.time.toMillis() - 172800000);
      allow create: if active() && !isOps()
        && expenseOk(request.resource.data)
        && request.resource.data.id == id
        && request.resource.data.by == profile().username
        && (isAdmin() || (request.resource.data.at > request.time.toMillis() - 600000
                          && request.resource.data.at < request.time.toMillis() + 600000));
      allow update: if isAdmin() && expenseOk(request.resource.data) && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin();
    }

    // ---------- Inventario de insumos ----------
    // El stock solo cambia junto con un movimiento (compra, uso o conteo) creado en la misma operación.
    function moveFor(sid) { return getAfter(/databases/$(db)/documents/supplyMoves/$(request.resource.data.lastMove)).data; }
    match /supplies/{id} {
      allow read: if active();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'name', 'unit', 'stock', 'min', 'createdAt', 'updatedAt'])
        && request.resource.data.id == id
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && str(request.resource.data.unit, 20)
        && request.resource.data.stock is number && request.resource.data.stock >= 0 && request.resource.data.stock < 1000000
        && request.resource.data.min is number && request.resource.data.min >= 0 && request.resource.data.min < 1000000;
      allow update: if active() && request.resource.data.id == resource.data.id && (
          // Datos del insumo (solo administrador), sin tocar el stock
          (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'unit', 'min', 'updatedAt'])
            && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
            && str(request.resource.data.unit, 20)
            && request.resource.data.min is number && request.resource.data.min >= 0 && request.resource.data.min < 1000000)
          // Cambio de stock: debe venir con su movimiento nuevo
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt', 'lastMove'])
            && request.resource.data.lastMove is string
            && !exists(/databases/$(db)/documents/supplyMoves/$(request.resource.data.lastMove))
            && existsAfter(/databases/$(db)/documents/supplyMoves/$(request.resource.data.lastMove))
            && moveFor(id).sid == id
            && request.resource.data.stock == resource.data.stock + moveFor(id).qty
            && request.resource.data.stock is number && request.resource.data.stock >= 0 && request.resource.data.stock < 1000000)
        );
      allow delete: if isAdmin();
    }
    match /supplyMoves/{id} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['id', 'sid', 'type', 'qty', 'at', 'by', 'note', 'expenseId'])
        && request.resource.data.id == id
        && request.resource.data.by == profile().username
        && request.resource.data.qty is number && request.resource.data.qty > -1000000 && request.resource.data.qty < 1000000
        && ts(request.resource.data.at)
        && (!('note' in request.resource.data) || str(request.resource.data.note, 200))
        && (!('expenseId' in request.resource.data) || str(request.resource.data.expenseId, 40))
        && getAfter(/databases/$(db)/documents/supplies/$(request.resource.data.sid)).data.lastMove == id
        && (
          (request.resource.data.type == 'uso' && request.resource.data.qty < 0)
          || (request.resource.data.type == 'compra' && request.resource.data.qty > 0 && !isOps())
          || (request.resource.data.type == 'ajuste' && isAdmin())
        );
      allow update, delete: if false;
    }

    // ---------- Usuarios y roles: solo el administrador. El primer administrador se crea una sola vez. ----------
    function userOk(d) {
      return d.keys().hasOnly(['username', 'name', 'role', 'createdAt', 'createdBy', 'email'])
        && validRole(d.role) && str(d.username, 40) && str(d.name, 80)
        && (!('email' in d) || (str(d.email, 120) && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')));
    }
    match /users/{uid} {
      allow read: if active();
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if (isAdmin() && userOk(request.resource.data))
        || (signedIn() && request.auth.uid == uid && !bootstrapped() && request.resource.data.role == 'admin' && userOk(request.resource.data));
      allow update: if isAdmin() && userOk(request.resource.data) && request.resource.data.username == resource.data.username;
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /config/bootstrap {
      allow read: if true;
      allow create: if signedIn() && !bootstrapped()
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Precios y ajustes: el administrador. Recepción y administrador avanzan el N° de recibo de uno en uno.
    match /config/settings {
      allow read: if active();
      allow create: if isAdmin();
      allow update: if (isAdmin() && request.resource.data.size() <= 40)
        || (active() && !isOps()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextNumber'])
            // cada equipo reserva de 1 a 20 números (para poder numerar sin internet)
            && request.resource.data.nextNumber > resource.data.nextNumber
            && request.resource.data.nextNumber <= resource.data.nextNumber + 20);
      allow delete: if false;
    }

    // Datos del responsable para el aviso de privacidad: los lee cualquiera (privacidad.html es pública),
    // solo el administrador los cambia, y solo con estos campos.
    match /config/privacy {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['titular', 'ruc', 'direccion', 'correo', 'whatsapp', 'vigencia', 'anios', 'fotosDias'])
        && str(request.resource.data.titular, 120) && str(request.resource.data.ruc, 13)
        && request.resource.data.ruc.matches('^[0-9]*$')
        && str(request.resource.data.direccion, 200) && str(request.resource.data.correo, 120)
        && str(request.resource.data.whatsapp, 30)
        && request.resource.data.vigencia is string && request.resource.data.vigencia.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && request.resource.data.anios is int && request.resource.data.anios >= 1 && request.resource.data.anios <= 10
        && (!('fotosDias' in request.resource.data) || (request.resource.data.fotosDias is int && request.resource.data.fotosDias >= 1 && request.resource.data.fotosDias <= 365));
      allow delete: if false;
    }

    // Quién está conectado: cada persona actualiza solo su propio estado.
    match /presence/{uid} {
      allow read: if active();
      allow write: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'u', 'name', 'role', 'lastSeen', 'since', 'offline'])
        && request.resource.data.uid == uid && request.resource.data.role == profile().role
        && str(request.resource.data.name, 80) && str(request.resource.data.u, 40)
        && ts(request.resource.data.lastSeen) && request.resource.data.offline is bool;
    }

    // Registro de ingresos del personal: cada uno registra el suyo; solo el administrador lo ve.
    match /logins/{id} {
      allow read: if isAdmin();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['uid', 'u', 'name', 'role', 'at', 'day', 'type', 'dev'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == profile().role
        && str(request.resource.data.name, 80) && str(request.resource.data.u, 40)
        && ts(request.resource.data.at) && str(request.resource.data.day, 10)
        && request.resource.data.type in ['login', 'apertura'] && str(request.resource.data.dev, 20);
    }

    // Todo lo demás queda cerrado.
    match /{document=**} { allow read, write: if false; }
  }
}
