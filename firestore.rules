rules_version = '2';
// Reglas de seguridad de Shoe Cleaning.
// Copia TODO este texto en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn()     { return request.auth != null; }
    function profile()      { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function active()       { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function isAdmin()      { return active() && profile().role == 'admin'; }
    function bootstrapped() { return exists(/databases/$(db)/documents/config/bootstrap); }

    // Usuarios y roles: solo el administrador los crea, cambia o desactiva.
    // Excepción: el primer administrador se crea una sola vez.
    match /users/{uid} {
      allow read: if active();
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && !bootstrapped() && request.resource.data.role == 'admin');
      allow update, delete: if isAdmin();
    }

    // Marca de que ya existe el primer administrador.
    match /config/bootstrap {
      allow read: if true;
      allow create: if signedIn() && !bootstrapped()
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Precios y ajustes: los cambia el administrador.
    // Recepción solo puede avanzar el número de recibo.
    match /config/settings {
      allow read: if active();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextNumber'])
            && request.resource.data.nextNumber == resource.data.nextNumber + 1);
      allow delete: if false;
    }

    // Pedidos: todos los usuarios activos los ven y actualizan. Solo el administrador borra.
    match /orders/{id} {
      allow read, create, update: if active();
      allow delete: if isAdmin();
    }

    // Fotos de recepción y entrega (comprimidas, ~60 KB). Solo el administrador borra.
    match /photos/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.data is string && request.resource.data.data.size() < 200000;
      allow delete: if isAdmin();
    }

    // Quién está conectado: cada persona actualiza solo su propio estado.
    match /presence/{uid} {
      allow read: if active();
      allow write: if active() && request.auth.uid == uid;
    }

    // Registro de ingresos del personal: cada uno registra el suyo; solo el administrador lo ve.
    match /logins/{id} {
      allow read: if isAdmin();
      allow create: if active() && request.resource.data.uid == request.auth.uid;
    }
  }
}
